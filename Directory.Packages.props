<Project>

  <!-- One version per package for the whole repository. Individual projects list
       which packages they need, never which version — that is what stops two
       services quietly drifting onto different Google.Protobuf releases. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pins transitive dependencies to the versions below too. Without this, Npgsql drags
         in EntityFrameworkCore.Relational 10.0.4 while EntityFrameworkCore itself resolves
         to 10.0.5, and the two disagree at runtime: the app builds and then fails on the
         first query with "Could not load file or assembly ... Relational, Version=10.0.5.0". -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.34.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageVersion Include="TUnit" Version="1.17.7" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" />
    <!-- Pinned to override the 2024.2.0 that Testcontainers drags in through its SSH
         transport, which carries a high-severity advisory. Transitive pinning is what
         makes this one line enough. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- MediatR 12 is Apache-2.0. Version 13 moved to a commercial licence; nothing here
         needs what it added, so the last freely licensed line is the one to sit on. -->
    <PackageVersion Include="MediatR" Version="12.2.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5" />
    <!-- Pinned to override a vulnerable 9.0.0 that EF Core's design-time tooling drags in
         through Microsoft.Build.Tasks.Core. Build-time only, never shipped, but NuGet audit
         is right to flag it and a direct reference is the documented way to win. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

</Project>
