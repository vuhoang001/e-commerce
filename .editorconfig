root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,proto,md,ts,js}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.cs]
# Keep C# conventions explicit — architecture tests assume them
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
