<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The composition root and the transport. It references Infrastructure only to
       register it — no persistence code lives here. Folders inside a layer group by
       feature (Orders/), with genuinely cross-cutting transport concerns in Grpc/.
       See ADR-004. -->

  <PropertyGroup>
    <RootNamespace>Ecommerce.OrderService.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../building-blocks/contracts-csharp/Ecommerce.Contracts.csproj" />
    <ProjectReference Include="../Application/Ecommerce.OrderService.Application.csproj" />
    <ProjectReference Include="../Infrastructure/Ecommerce.OrderService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
