<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wraps the generated stubs in building-blocks/gen/csharp so every C# service
       references one project instead of globbing generated files itself. Bumping a
       protobuf version happens here, once. -->

  <PropertyGroup>
    <RootNamespace>Ecommerce</RootNamespace>
    <!-- The compiled sources here are generated by `make proto`, not written by
         hand. Holding generated code to the repository's nullable and
         warnings-as-errors policy would only mean editing it, which rule 1 forbids. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../gen/csharp/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
  </ItemGroup>

</Project>
